# Copy to .env and adjust. Never commit a real .env.
# PostgreSQL (target):  postgresql+psycopg://vdm:<password>@db-host:5432/vdm
# SQLite (local dev):   sqlite:///./data/vdm.db
VDM_DATABASE_URL=sqlite:///./data/vdm.db
VDM_MAX_UPLOAD_MB=50
VDM_MAX_INVENTORY_ROWS=20000
# Recorded as the actor in audit events until authentication arrives in Phase 2
VDM_DEFAULT_ACTOR=local-user
VDM_CRITICALITY_VALUES=["critical","high","medium","low"]
# Import policy: partial imports always need allow_partial=true + partial_reason; this can forbid them entirely
VDM_ALLOW_PARTIAL_IMPORTS=true
VDM_MAX_INVALID_RECORD_RATIO=0.5
VDM_MAX_TELEMETRY_UPLOAD_MB=512
VDM_MAX_TELEMETRY_ROWS=2000000
VDM_INVENTORY_STALENESS_DAYS=90
